.package-link{border:1px solid var(--line);padding:12px 16px;justify-content:center;min-height:46px}
.hero-chat{border:1px solid var(--line);padding:11px 16px;min-height:46px;justify-content:center}
/* Self-hosted Sinhala subset: downloaded only when Sinhala text uses it. */
@font-face{font-family:'TrustBridge Noto Sans Sinhala';font-style:normal;font-weight:400 700;font-display:swap;src:url('/fonts/noto-sans-sinhala.woff2') format('woff2');unicode-range:U+0D80-0DFF,U+200C-200D,U+25CC,U+111E1-111F4}
.language:lang(si){font-family:'TrustBridge Noto Sans Sinhala','Noto Sans Sinhala','Iskoola Pota',sans-serif}
html[lang=si] body{font-family:'TrustBridge Noto Sans Sinhala','Noto Sans Sinhala',Arial,sans-serif;font-weight:500;line-height:1.85;letter-spacing:0}
html[lang=si] .hero-tagline,html[lang=si] .founder blockquote,html[lang=si] .hero-seal span,html[lang=si] .final-cta .eyebrow{font-family:'TrustBridge Noto Sans Sinhala','Noto Sans Sinhala',Arial,sans-serif;font-style:normal;letter-spacing:0;line-height:1.6}
@font-face{font-family:'Abhaya Libre';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/abhaya-libre-sinhala-700.woff2') format('woff2');unicode-range:U+0D80-0DFF,U+200C-200D,U+25CC,U+111E1-111F4}
html[lang=si] h1,html[lang=si] h2,html[lang=si] h3{font-family:'Abhaya Libre','TrustBridge Noto Sans Sinhala',serif;font-weight:700;font-style:normal;line-height:1.3;letter-spacing:0}
html[lang=si] .hero h1,html[lang=si] .page-heading h1{font-size:clamp(2.2rem,3.4vw,3.4rem)}
html[lang=si] h2{font-size:clamp(1.75rem,2.6vw,2.6rem)}
html[lang=si] .package-card h3{font-size:24px;line-height:1.35}
@media(max-width:760px){html[lang=si] .hero h1,html[lang=si] .page-heading h1{font-size:clamp(1.9rem,7vw,2.6rem)}html[lang=si] h2{font-size:1.85rem}html[lang=si] .package-card h3{font-size:23px}}
html[lang=si] .button,html[lang=si] .package-link,html[lang=si] .hero-chat{font-weight:600;line-height:1.8;letter-spacing:0}
html[lang=si] .eyebrow{letter-spacing:.025em}

.licensed-photo .temple-placeholder{min-height:0;height:300px;padding:24px;text-align:center;gap:12px}
.licensed-photo .temple-placeholder small{font-size:11px}
.package-photo .temple-placeholder{height:175px}
.package-detailed .package-photo .temple-placeholder{height:260px}
.about-photography .temple-placeholder{height:480px}
@media(max-width:760px){.about-photography .temple-placeholder{height:300px}.package-detailed .package-photo .temple-placeholder{height:230px}.destination-gallery .temple-placeholder{height:220px}}
@media(max-width:420px){.package-photo .temple-placeholder{height:200px}}


/* TRUSTBRIDGE SINHALA TYPOGRAPHY FIX */

:lang(si) h1,
:lang(si) h2,
:lang(si) h3,
:lang(si) h4,
:lang(si) h5,
:lang(si) h6 {
    font-family: "Abhaya Libre", "Noto Sans Sinhala", serif;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: normal;
}

:lang(si) :is(h1, h2, h3, h4, h5, h6) span {
    font-family: inherit;
    letter-spacing: normal;
}

@media (max-width: 640px) {
    :lang(si) h1 {
        font-size: clamp(2rem, 7vw, 3rem);
        line-height: 1.35;
    }

    :lang(si) h2 {
        line-height: 1.4;
    }
}


/* TRUSTBRIDGE HERO FULL IMAGE: BEGIN */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: calc(100svh - 88px);
  overflow: hidden;
  background: #082346;
  isolation: isolate;
}

.hero .hero-media {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.hero .hero-media figure,
.hero .hero-media picture {
  width: 100%;
  height: 100%;
  margin: 0;
}

.hero .hero-media img,
.hero .hero-media .temple-photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    rgba(8,35,70,0.88) 0%,
    rgba(8,35,70,0.75) 35%,
    rgba(8,35,70,0.40) 65%,
    rgba(8,35,70,0.12) 100%
  );
}

.hero .hero-copy {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 760px;
  padding: clamp(2rem,5vw,5rem);
  color: #ffffff;
}

.hero .hero-copy h1,
.hero .hero-copy h2,
.hero .hero-copy h3,
.hero .hero-copy p {
  color: #ffffff;
}

.hero .hero-copy .eyebrow {
  color: #d4af37;
}

.hero .hero-copy .tagline {
  color: #f5d77a;
}

.hero .hero-media figcaption {
  position: absolute;
  z-index: 2;
  bottom: 1rem;
  left: 1rem;
  color: white;
  background: rgba(8,35,70,0.5);
  padding: 0.4rem 0.8rem;
  border-radius: 9999px;
}

@media (max-width: 1024px) {
  .hero {
    min-height: 85svh;
  }

  .hero .hero-copy {
    max-width: 680px;
    padding: 2rem;
  }
}

@media (max-width: 768px) {
  .hero {
    min-height: 90svh;
    padding: 4rem 0;
  }

  .hero .hero-copy {
    max-width: 100%;
    padding: 1.5rem;
  }

  .hero::after {
    background: linear-gradient(
      180deg,
      rgba(8,35,70,0.85) 0%,
      rgba(8,35,70,0.72) 55%,
      rgba(8,35,70,0.40) 100%
    );
  }

  .hero .hero-media figcaption {
    bottom: 0.75rem;
    font-size: 0.75rem;
  }
}

/* TRUSTBRIDGE HERO FULL IMAGE: END */
